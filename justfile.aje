# AJE-local recipes. Keep this file separate from the repository justfile so
# rebases of upstream justfile changes cannot overwrite the local workflow.
set working-directory := "codex-rs"
set positional-arguments

rust_min_stack := "8388608" # 8 MiB

# Show the recipes in this local justfile.
help:
    just --justfile {{ justfile_directory() }}/justfile.aje --list

# Build a locally identifiable CLI binary. Pass `--release` for an optimized build.
build-local *args:
    cargo build -p codex-cli "$@"

# Show deployment versions, build commits, and changes since each build.
deployment-status:
    @python3 "{{ justfile_directory() }}/scripts/deployment-status.py"

# Build the optimized local CLI binary.
# Fetch tags for the reachable release baseline; the build remains usable offline.
[unix]
build:
    git fetch upstream --tags --quiet || echo 'Could not refresh upstream Git tags; using existing local tags.' >&2; RUSTC=$(rustup which --toolchain 1.95.0 rustc) CARGO_BUILD_JOBS=4 nice -n 10 python3 "{{ justfile_directory() }}/scripts/local_build_version.py" python3 "{{ justfile_directory() }}/scripts/local_v8.py" rustup run 1.95.0 cargo build -p codex-cli --release

[windows]
build:
    git fetch upstream --tags --quiet; if ($LASTEXITCODE -ne 0) { Write-Warning 'Could not refresh upstream Git tags; using existing local tags.' }
    python "{{ justfile_directory() }}/scripts/local_build_version.py" cargo build -p codex-cli --release

# Build the companion executable used by the optional Code Mode feature.
[unix]
build-code-mode-host:
    RUSTC=$(rustup which --toolchain 1.95.0 rustc) CARGO_BUILD_JOBS=4 nice -n 10 python3 "{{ justfile_directory() }}/scripts/local_v8.py" rustup run 1.95.0 cargo build -p codex-code-mode-host --release

[windows]
build-code-mode-host:
    cargo build -p codex-code-mode-host --release

# Run the requested tests with the repository's usual local settings.
[unix]
test *args:
    RUST_MIN_STACK={{ rust_min_stack }} NEXTEST_PROFILE=local python3 "{{ justfile_directory() }}/scripts/local_v8.py" cargo nextest run --no-fail-fast "$@"

[windows]
test *args:
    $env:RUST_MIN_STACK = "{{ rust_min_stack }}"; $env:NEXTEST_PROFILE = "local"; cargo nextest run --no-fail-fast @args

# Copy the validated release binary into the staged local deployment slot.
[unix]
deploy-next: build build-code-mode-host
    mkdir -p "$HOME/bin"
    cp target/release/codex "$HOME/bin/codex-aje-next.tmp"
    if [ "$(uname -s)" = Darwin ]; then just --justfile {{ justfile_directory() }}/justfile.aje sign-binary "$HOME/bin/codex-aje-next.tmp"; fi
    mv -f "$HOME/bin/codex-aje-next.tmp" "$HOME/bin/codex-aje-next"
    cp target/release/codex-code-mode-host "$HOME/bin/codex-code-mode-host.tmp"
    if [ "$(uname -s)" = Darwin ]; then just --justfile {{ justfile_directory() }}/justfile.aje sign-binary "$HOME/bin/codex-code-mode-host.tmp"; fi
    mv -f "$HOME/bin/codex-code-mode-host.tmp" "$HOME/bin/codex-code-mode-host"

[windows]
deploy-next: build build-code-mode-host
    New-Item -ItemType Directory -Force "$HOME/bin" | Out-Null
    Copy-Item target/release/codex "$HOME/bin/codex-aje-next.tmp"
    Move-Item -Force "$HOME/bin/codex-aje-next.tmp" "$HOME/bin/codex-aje-next"
    Copy-Item target/release/codex-code-mode-host "$HOME/bin/codex-code-mode-host.tmp"
    Move-Item -Force "$HOME/bin/codex-code-mode-host.tmp" "$HOME/bin/codex-code-mode-host"

# Sign a local macOS binary with the first available Developer ID identity.
[unix]
sign-binary binary:
    @identity=$(security find-identity -v -p codesigning | sed -n 's/^[[:space:]]*[0-9]*) \([[:xdigit:]]\{40\}\) "Developer ID Application:.*/\1/p' | head -n 1); test -n "$identity" || { echo 'No Developer ID Application identity found.' >&2; exit 1; }; codesign --force --timestamp --sign "$identity" "{{ binary }}"

# Sign the staged local deployment in place.
[unix]
sign-next:
    just --justfile {{ justfile_directory() }}/justfile.aje sign-binary "$HOME/bin/codex-aje-next"

# Promote the staged local binary to the active local deployment.
[unix]
promote-next:
    test -x "$HOME/bin/codex-aje-next"
    cp "$HOME/bin/codex-aje-next" "$HOME/bin/codex-aje.tmp"
    mv -f "$HOME/bin/codex-aje.tmp" "$HOME/bin/codex-aje"
