#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

version=$(just --version)
version=${version#just }
major=${version%%.*}
minor=${version#*.}
minor=${minor%%.*}
case "$major:$minor" in
    *[!0-9:]*|:*|*:)
        echo "Could not determine the installed just version: $version" >&2
        exit 1
        ;;
esac
if [ "$major" -lt 1 ] || { [ "$major" -eq 1 ] && [ "$minor" -lt 33 ]; }; then
    echo "justa requires just 1.33.0 or newer (installed: $version)." >&2
    echo "Using: $(command -v just)" >&2
    echo "Upgrade just using your package manager, or run: cargo install just --locked" >&2
    echo 'If a newer version is already installed, check your PATH with: which -a just' >&2
    exit 1
fi

exec just --justfile "$repo_root/justfile.aje" "$@"
